{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "set NEXT_FORCE_WEBPACK=1&& set NEXT_DISABLE_SOURCEMAPS=1&& next dev",
    "build": "next build",
    "check:gpt-contract": "node scripts/check-gpt-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:gpt-contract && npm run build",
    "start": "next start",
    "lint": "eslint",
    "vercel-build": "next build",
    "prisma": "prisma",
    "sync:sqlite-to-supabase": "node scripts/sync-sqlite-to-supabase.cjs"
  },
  "dependencies": {
    "@prisma/client": "5.19.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/supabase-js": "^2.112.2",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "5.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
